{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023"], "module": "NodeNext", "moduleResolution": "NodeNext",
    "rootDir": "src", "outDir": "dist/node", "strict": true, "skipLibCheck": true,
    "esModuleInterop": true, "noUncheckedIndexedAccess": true, "types": ["node"]
  },
  "include": ["src/server", "src/shared"]
}

