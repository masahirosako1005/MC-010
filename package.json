{
  "name": "kondo-anatato",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=26 <27",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch --env-file-if-exists=.env src/server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node --env-file-if-exists=.env dist/node/server/index.js",
    "check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:e2e": "node node_modules/@playwright/test/cli.js test",
    "db:migrate": "tsx --env-file-if-exists=.env src/server/db-cli.ts migrate",
    "db:seed": "tsx --env-file-if-exists=.env src/server/db-cli.ts seed",
    "data:inspect": "tsx src/server/import-cli.ts inspect",
    "data:import": "tsx --env-file-if-exists=.env src/server/import-cli.ts import",
    "data:verify": "node --env-file-if-exists=.env scripts/verify-sample.mjs"
  },
  "dependencies": {
    "cookie-parser": "1.4.7",
    "csv-parse": "7.0.3",
    "express": "5.3.0",
    "html-to-image": "1.11.13",
    "lucide-react": "0.468.0",
    "multer": "2.5.0",
    "pg": "8.20.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.1.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.18.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "concurrently": "9.2.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}

